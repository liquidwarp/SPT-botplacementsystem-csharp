        </Reference>
    </ItemGroup>

    <Target Name="RequireSPTPath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(SPTPath)' == ''" Text="Missing SPT path" />
    </Target>
</Project>
