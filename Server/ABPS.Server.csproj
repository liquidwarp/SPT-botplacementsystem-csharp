<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>BotPlacementSystemServer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ModDir>SPT_Runtime\user\mods\$(Authors)-$(ModName)</ModDir>
        <InstallMod Condition="'$(InstallServerMod)' == 'True'">True</InstallMod>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTushonka.Common" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.DI" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Reflection" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Server.Core" Version="$(SPTPackageVersion)" />
        <PackageReference Include="SPTushonka.Server.Web" Version="$(SPTPackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ModContent Include="LICENSE" />
        <ModContent Include="Defaults\**" />
        <ModContent Include="wwwroot\**" />
    </ItemGroup>
</Project>
